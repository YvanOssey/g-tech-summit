# Copy to .env.local for local work, and set the same variables at the host.
# .env.local is ignored by Git: never commit real keys.

# Public address of the site, without a trailing slash.
# Required in production: canonical URLs, sitemap.xml, robots.txt and social
# previews are built from it.
NEXT_PUBLIC_SITE_URL=https://summit.ghostech.tech

# ── Supabase (Project Settings → API Keys) ──────────────────────────────
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). Safe in the browser: Row Level Security
# limits it to published content.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…). SERVER ONLY — bypasses Row Level Security.
# Never prefix it with NEXT_PUBLIC_, never paste it in a chat or a commit.
SUPABASE_SECRET_KEY=

# ── Genius Pay (dashboard → API keys) — SERVER ONLY ─────────────────────
# Test keys contain "_sandbox_": orders are then flagged as tests.
# Live keys only on the production host, once the sales rules are ready.
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
# Secret of the webhook declared in Genius Pay (whsec_…), shown once at
# creation. Webhook address: https://<domain>/api/paiements/webhook
GENIUSPAY_WEBHOOK_SECRET=

# ── Anti-robot check on the checkout (Cloudflare Turnstile) — SERVER ONLY ─
# Widget created at dash.cloudflare.com → Turnstile, for summit.ghostech.tech.
# Enforced as soon as both are set. The site key is public (sent to the
# browser by the page); the secret key never leaves the server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Maintenance mode — SERVER ONLY ─────────────────────────────────────
# 1 = visitors see "Le site revient très vite" on every public page; the
# admin, payment notifications and tickets keep working. Empty or 0 = site open.
MAINTENANCE_MODE=

# ── E-mail (mailbox billetterie@ghostech.tech, Hostinger) — SERVER ONLY ─
# Tickets are e-mailed after payment. Without these, tickets are still
# reachable from the confirmation page, and admins can send them later.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=billetterie@ghostech.tech
SMTP_PASS=
MAIL_FROM=G-TECH SUMMIT <billetterie@ghostech.tech>
